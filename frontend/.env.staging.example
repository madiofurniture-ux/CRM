# Copy to .env.staging (gitignored) for a staging build, or pass these two
# vars directly to `npm run build` / your CI staging job:
#
#   REACT_APP_BACKEND_URL=... REACT_APP_ENV=staging npm run build
#
# REACT_APP_ENV=staging is what makes Layout.jsx show the STAGING/TEST banner.
REACT_APP_BACKEND_URL=https://madio-crm-api-staging.onrender.com
REACT_APP_ENV=staging
