{
  "theme": "light",
  "archetype": "Organic & Earthy",
  "domain_context": "Business CRM for Interior Design / Furniture",
  "typography": {
    "headings": {
      "family": "Manrope",
      "weights": ["500", "600", "700"],
      "usage": "Use for all page titles, KPI values, section headers."
    },
    "body": {
      "family": "IBM Plex Sans",
      "weights": ["400", "500", "600"],
      "usage": "Use for all dense data, table rows, standard text, kanban card details."
    },
    "mono": {
      "family": "JetBrains Mono",
      "weights": ["400", "500"],
      "usage": "Use for SKUs, inventory counts, monetary values in tables."
    }
  },
  "colors": {
    "background": {
      "default": "#F8F7F4",
      "surface": "#FDFDFD",
      "surface_hover": "#F2F0EB",
      "sidebar": "#F4F3EE"
    },
    "text": {
      "primary": "#1A1D1A",
      "secondary": "#5C5F5C",
      "tertiary": "#8A8C8A",
      "inverse": "#FFFFFF"
    },
    "brand": {
      "primary": "#C85A32",
      "primary_hover": "#A84A28",
      "primary_light": "#F7EBE6"
    },
    "accent": {
      "success": "#4A5D4E",
      "success_bg": "#EDF2EE",
      "warning": "#D48B30",
      "warning_bg": "#FDF4E7",
      "danger": "#B24040",
      "danger_bg": "#F8EAEA"
    },
    "border": {
      "default": "#E2E0D9",
      "light": "#EBE9E4"
    }
  },
  "spacing": {
    "container_padding": "p-6 md:p-8",
    "section_gap": "gap-6 md:gap-8",
    "widget_gap": "gap-4",
    "table_cell": "px-4 py-3"
  },
  "borders": {
    "radius": {
      "sm": "rounded-md",
      "md": "rounded-lg",
      "lg": "rounded-xl",
      "full": "rounded-full"
    },
    "width": {
      "default": "border"
    }
  },
  "shadows": {
    "sm": "shadow-[0_1px_2px_rgba(26,29,26,0.05)]",
    "md": "shadow-[0_4px_12px_rgba(26,29,26,0.05)]",
    "lg": "shadow-[0_12px_24px_rgba(26,29,26,0.08)]"
  },
  "components": {
    "sidebar": {
      "background": "bg-[#F4F3EE]",
      "text": "text-[#5C5F5C]",
      "active_bg": "bg-[#EAE9E3]",
      "active_text": "text-[#1A1D1A]",
      "border": "border-r border-[#E2E0D9]"
    },
    "topbar": {
      "background": "bg-white/80 backdrop-blur-md",
      "border": "border-b border-[#E2E0D9]",
      "height": "h-16"
    },
    "kpi_card": {
      "background": "bg-[#FDFDFD]",
      "border": "border border-[#E2E0D9]",
      "radius": "rounded-xl",
      "shadow": "shadow-sm",
      "padding": "p-5"
    },
    "table": {
      "header_bg": "bg-[#F4F3EE]",
      "header_text": "text-xs font-semibold text-[#5C5F5C] uppercase tracking-wider",
      "row_border": "border-b border-[#EBE9E4]",
      "row_hover": "hover:bg-[#F8F7F4]"
    },
    "kanban": {
      "column_bg": "bg-[#F4F3EE]",
      "card_bg": "bg-[#FDFDFD]",
      "card_border": "border border-[#E2E0D9]",
      "card_shadow": "shadow-sm hover:shadow-md transition-shadow"
    },
    "button_primary": {
      "background": "bg-[#C85A32]",
      "text": "text-white",
      "hover": "hover:bg-[#A84A28]",
      "radius": "rounded-lg"
    },
    "badge": {
      "radius": "rounded-full",
      "padding": "px-2.5 py-0.5",
      "text": "text-xs font-medium"
    },
    "login_screen": {
      "layout": "split_screen",
      "left_pane": "image_cover",
      "right_pane": "bg-[#FDFDFD] flex items-center justify-center"
    }
  },
  "icons": {
    "library": "lucide-react",
    "stroke_width": "1.5"
  },
