{
  "name": "madio_doors_windows",
  "version": "1.0.0",
  "depends": ["core_crm"],
  "custom_fields": {
    "opportunity": [
      { "key": "survey_id", "label": "Survey ID", "type": "text" },
      { "key": "measurement_data", "label": "Measurement Data", "type": "json" },
      { "key": "product_category", "label": "Product Category", "type": "select",
        "options": ["Door", "Window", "Partition", "Facade"] },
      { "key": "installation_type", "label": "Installation Type", "type": "select",
        "options": ["New Construction", "Retrofit", "Replacement"] },
      { "key": "preferred_installation_date", "label": "Preferred Installation Date", "type": "date" }
    ]
  },
  "pipelines": {
    "opportunity": [
      { "key": "new", "label": "New", "terminal": false, "won": false },
      { "key": "site_survey", "label": "Site Survey", "terminal": false, "won": false },
      { "key": "quotation", "label": "Quotation", "terminal": false, "won": false },
      { "key": "negotiation", "label": "Negotiation", "terminal": false, "won": false },
      { "key": "won", "label": "Won", "terminal": true, "won": true },
      { "key": "lost", "label": "Lost", "terminal": true, "won": false }
    ]
  },
  "quotations": {
    "templates": ["doors_windows"]
  },
  "permissions": {}
}
